   "source": [
    " # Classification Report\n",
    "# ===============================\n",
    "\n",
    "print(\"\\nLogistic Regression Report\")\n",
    "print(classification_report(y_test, y_pred_lr))\n",
    "\n",
    "print(\"\\nRandom Forest Report\")\n",
    "print(classification_report(y_test, y_pred_rf))"
   ]
  },
